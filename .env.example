# Which AI provider to use: "openai" or "gemini"
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Gemini
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-1.5-flash

# MongoDB (open MongoDB Compass and point it at the same URI to inspect data)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=nexus_chat

# Clerk — find these in the Clerk Dashboard:
#   CLERK_JWKS_URL:  API Keys -> Show JWT public key -> JWKS URL
#   CLERK_ISSUER:    same page, the "Issuer" value (looks like https://xxx.clerk.accounts.dev)
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=https://your-app.clerk.accounts.dev

# Credits (rate limiting)
CREDIT_LIMIT=100
CREDIT_RESET_HOURS=1

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
